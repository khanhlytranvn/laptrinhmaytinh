flowchart LR
    Guest[Khách] --> Register[Đăng ký]
    Guest --> Login[Đăng nhập]
    User[Người dùng] --> Dashboard[Xem Dashboard]
    User --> Transaction[Quản lý giao dịch]
    User --> Category[Quản lý danh mục]
    User --> Budget[Thiết lập ngân sách]
    User --> Savings[Quản lý mục tiêu tiết kiệm]
    User --> SavingsHistory[Ghi nhận gửi và rút tiết kiệm]
    User --> Debt[Theo dõi khoản cần trả và cần thu]
    User --> DebtHistory[Ghi nhận thanh toán và thu hồi nợ]
    User --> History[Tra cứu lịch sử]
    User --> Report[Xem và xuất báo cáo]
    User --> Logout[Đăng xuất]
    Admin[Quản trị viên] --> Users[Quản lý tài khoản]
    Admin --> Dashboard
    Admin --> Transaction
    Admin --> Category
    Admin --> Budget
    Admin --> Savings
    Admin --> SavingsHistory
    Admin --> Debt
    Admin --> DebtHistory
    Admin --> History
    Admin --> Report
